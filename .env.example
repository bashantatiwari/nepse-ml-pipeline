# Environment configuration
# Rename this file to .env before running docker-compose

# MariaDB (Service name in Docker: mariadb-columnstore)
MARIADB_HOST=mariadb-columnstore
MARIADB_PORT=3306
MARIADB_USER=nepse_user
MARIADB_PASSWORD=nepse_secure_password
MARIADB_DATABASE=nepse_mlops

# Redis (Service name in Docker: redis)
REDIS_HOST=redis
REDIS_PORT=6379

# MLflow (Service name in Docker: mlflow)
MLFLOW_TRACKING_URI=http://mlflow:5000
